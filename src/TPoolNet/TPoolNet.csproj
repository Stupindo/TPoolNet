<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Packaging metadata -->
    <PackageId>TPoolNet</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>TPoolNet Contributors</Authors>
    <Description>High-performance SQL Server query and connection optimization library for Entity Framework Core.</Description>
    <PackageTags>efcore;sqlserver;performance;pooling</PackageTags>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

</Project>
