<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSourceMapping>
    <!--
      Map all TPoolNet dependencies to nuget.org.
      The 'github' source (Stratly private feed) is not used by this project.
    -->
    <packageSource key="nuget.org">
      <package pattern="Microsoft.EntityFrameworkCore.*" />
      <package pattern="Microsoft.Extensions.*" />
      <package pattern="Microsoft.NET.Test.Sdk" />
      <package pattern="xunit" />
      <package pattern="xunit.*" />
      <package pattern="coverlet.*" />
      <package pattern="Testcontainers.*" />
      <package pattern="FluentAssertions" />
      <package pattern="dotnet-ef" />
    </packageSource>
    <packageSource key="github">
      <!-- Private feed for Stratly internal packages — not used by TPoolNet -->
      <package pattern="Stratly.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
